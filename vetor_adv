#include <stdio.h>
#include <string.h>

int main() {
    char status[20];
    
    
    printf("Verificador de Processos Jurídicos\n");
    printf("Digite o status do processo: \n");
    printf("ATIVO ou ARQUIVADO\n");
    scanf("%19s", status);
   
    if(strcmp(status, "ATIVO") == 0){
        printf("ALERTA: o processo está em andamento. Requer Atenção!\n");
    }else{
        if(strcmp(status, "ARQUIVADO") == 0){
        printf("INFO. O processo foi encerrado e arquivado\n");
    } else{
        printf("ERRO.Status desconhecido!");
    }
}
    return 0;
}
