#include <stdio.h>
#include <string.h>

int main() {
    char nome[50];
    char sobrenome[50];
    char nomeCompleto[100];
    
    
    printf("Digite o nome: ");
    scanf("%49s", nome);
    printf("Digite o sobrenome: ");
    scanf("%49s", sobrenome);
    
    strcpy(nomeCompleto, nome);

    strcat(nomeCompleto, " ");
    strcat(nomeCompleto, sobrenome);
    printf("\n NOME COMPLETO \n");
    printf("%s", nomeCompleto);
   
    return 0;
}
