#include <stdio.h>

int main() {
   int senha;
   
   do{
       printf("Cadastre uma senha de 04 dígitos: ");
       scanf("%d", &senha);
       
       if(senha < 1000 || senha > 9999){
           printf("Senha Inválida. Tente novamente!\n");
        }
       
   }while(senha < 1000 || senha > 9999);
   printf("Senha correta! %d", senha);
    return 0;
}
