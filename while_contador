#include <stdio.h>

int main() {
    int numero;
    int soma = 0;
    int contador = 1;
    
    while (contador <= 5){
        printf("Digite um número: ");
        scanf("%d", &numero);
        soma = soma + numero;
        contador ++;
    }
    printf("===========================\n");
    printf ("Soma final é de %d", soma);
}
